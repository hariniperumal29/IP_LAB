# Histogram Matching

from skimage.exposure import match_histograms
import numpy as np

# this algorithm automatically cal histogram of both images and does matchnig
matched_img = match_histograms(dark_img,bright_img)

matched_img = np.uint8(matched_img)

matched_hist = cv2.calcHist([matched_img],[0],None,[256],[0,256])

plt.figure(figsize=(12,8))
plt.subplot(1,2,1)
plt.imshow(matched_img,cmap='gray')
plt.title("Matched Image")

plt.subplot(1,2,2)
plt.plot(matched_hist)
plt.title("Matched Histogram")
--------------------------------------------------------------------------
# Calculating Measures:
from skimage.measure import shannon_entropy
def cal_measures(image):
    
    # Mean: Brighteness --> high mean --> more brightness
    #--. low mean --> less brightness
    mean = np.mean(image)
    
    # S.D: Spread of pixel values in image
    # more s.d --> spread over wider range
    sd = np.std(image)

    contrast = sd

    # Entropy
    entropy = shannon_entropy(image)

    return mean,sd,contrast,entropy

original_measure = cal_measures(dark_img)
equalized_measure = cal_measures(equalized_img)
matched_measure = cal_measures(matched_img)
-----------------------------------------------------
# Printing values:
import pandas as pd
data = pd.DataFrame(
    {
        'Image': ['Original_Img ','Equalized_Img','Matched_Img'],
        'Mean' : [original_measure[0],equalized_measure[0],matched_measure[0]],
        'SD' : [original_measure[1],equalized_measure[1],matched_measure[1]],
        'Contrast' : [original_measure[2],equalized_measure[2],matched_measure[2]],
