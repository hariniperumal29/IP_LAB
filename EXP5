# Cal measure :
# (i) MSE :
def cal_mse (img,filtered):
    mse = np.mean((img.astype(float) - filtered.astype(float))**2)
    return mse

--------------------------------------------------------------------
# cal Psnr

def cal_psnr (img,filtered):
    mse = cal_mse(img,filtered)
    if mse ==0:
        return float("inf")

    psnr = 10*np.log10((255**2)/mse)
    return psnr
----------------------------------------------------------
mse_mean  = cal_mse(image_rgb,mean_filter)
mse_gaussian = cal_mse(image_rgb,gaussian_filter)
mse_median = cal_mse(image_rgb,median_filter)
-------------------------------------------------
psnr_mean  = cal_psnr(image_rgb,mean_filter)
psnr_gaussian = cal_psnr(image_rgb,gaussian_filter)
psnr_median = cal_psnr(image_rgb,median_filter)
