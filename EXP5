# Reading an Image:
image  = cv2.imread("download.jpg")
import matplotlib.pyplot as plt
plt.imshow(image)
-------------------------------
# Convert to rgb
image_rgb = cv2.cvtColor(image,cv2.COLOR_BGR2RGB)
plt.imshow(image_rgb)
-----------------------------------------
# Create a noisey image [salt [white pixels] , pepper noise[black]]

# Copy of rgb image to add noise
noise_img  = image_rgb.copy()

# amount of noise
noise_amt = 0.05  # [5 %]

# Number_of _pixels to be modified: noise_amt * r*c
pixels = int (noise_amt * img_rgb.shape[0] * img_rgb.shape[1])
--------------------------------------------------------------------
# Adding salt noise
import numpy as np
for i in range(pixels//2):
    # generating random x  values in range [0,r]
    x= np.random.randint(0,image_rgb.shape[0])
    # generating random y values in range
    y = np.random.randint(0,image_rgb.shape[1])
    # Filling eith white 
    noise_img[x,y] = [255,255,255]

    -----------------------------------------------------------------
# Adding peper noise 
for i in range (pixels//2):
    x= np.random.randint(0,image_rgb.shape[0])
    y= np.random.randint(0,image_rgb.shape[1])
    noise_img[x,y] = [0,0,0]
-----------------------------------------------------------
# Adding filters :
# (i) Mean Filter:
# (img,kernel_size(r,c))
mean_filter = cv2.blur(noise_img,(5,5))
-----------------------------------------------------
# (ii) Gaussian Filter
# cal using weighted avg (more prefernce to nearby pixels)
gaussian_filter = cv2.GaussianBlur(noise_img,(5,5),0)
-----------------------------------------------------
#(iii) Median Filter :[Salt and Pepper Noise]
median_filter = cv2.medianBlur(noise_img,5)
---------------------------------------------------
