import cv2
------------------------------------------------
# Reading an Image

import matplotlib.pyplot as plt
image = cv2.imread("download.jpg")

# Displaying Image
plt.imshow(image)

#Display pixel values
print(image)
----------------------------------------------------
# Printing shape and size

print(image.shape) # h,w,c
print(image.size) # h*w*c
----------------------------------------------------

# Converting Bgr to Rgb
image_rgb = cv2.cvtColor (image,cv2.COLOR_BGR2RGB)
plt.imshow(image_rgb)

# Image dimensions
h,w,c = image_rgb.shape
print("height",h)
print("width",w)
print("channels",c)

print("dimensions",image_rgb.shape)

-------------------------------------------
# Convert BGR to Gray

image_gray = cv2.cvtColor(image,cv2.COLOR_BGR2GRAY)
plt.imshow(image_gray,cmap="gray")

h,w= image_gray.shape
print("height",h)
print("width",w)
print("dimensions",image_gray.shape)
----------------------------------------------------
# Resolution : H*W

h,w,c = image_rgb.shape
print("Resolution:", h ,"*",w,"pixcels")
------------------------------------------------------
# saving imag

cv2.imwrite("gray_strawberry.jpg",image_gray)
saved_img = cv2.imread("gray_strawberry.jpg")
plt.imshow(saved_img)

# Printing data type
print(saved_img.dtype)
-------------------------------------------------------
# Resize image

# (i) Method - 1:

resize_image = cv2.resize(image,(2000,1000)) # w, h
plt.imshow(resize_image)


# (ii) Method -2 

# fx, fy : sacling factor : reduce to 50% [0.5]
# Syntax: resize(image,dsize,fx,fy)
# --> dsize : specifiy dimensions  directly ignores fx fy
# --> fx : scale factor along x
# --> fy : scale factor along y

resize_image2 = cv2.resize(image,None,fx=1,fy=1)
resize_image3 = cv2.resize(image,(400,300),fx=0.5,fy=0.5)
----------------------------------------------------------

# Crop:
# Resize --> change dimensions
# Crop --> selcting a specific region
#  1st : [100:400] => include rows [row slicing]
# 2nd : [100:500] => include columns [col slicing]

crop_image = resize_image [100:400,100:500]
plt.imshow(cv2.cvtColor(crop_image,cv2.COLOR_BGR2RGB))
---------------------------------------------------------

# Rotation:

rotate = cv2.rotate(image,cv2.ROTATE_90_CLOCKWISE)
rotate2 = cv2.rotate(image,cv2.ROTATE_90_COUNTERCLOCKWISE)
rotate3 = cv2.rotate(image,cv2.ROTATE_180)
----------------------------------------------------------
